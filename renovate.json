{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>Nomira-OS/ci"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tools installed with pipx in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+run: pipx install \\S+==(?<currentValue>\\S+)"
      ]
    }
  ]
}
